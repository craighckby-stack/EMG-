/**
 * ARCHITECTURAL CONFIGURATION SCHEMA: .env.example
 * Role: Defines the required environment variables for the system kernel.
 * Integration: Parsed by lib/env-validator.ts during system boot and diagnostic health checks.
 * 
 * Mutation Note: Added NODE_ENV and DEBUG_MODE to support diagnostic-engine telemetry.
 */

# --- CORE KERNEL CONFIGURATION ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- SYSTEM DIAGNOSTIC & TELEMETRY ---
# NODE_ENV: Set to 'production' for optimized performance or 'development' for verbose logging.
NODE_ENV="development"

# DEBUG_MODE: Enables granular diagnostic reporting in the system console.
DEBUG_MODE="false"

# --- PERSISTENCE LAYER ---
# MEMORY_PATH: Defines the local directory for flat-file memory persistence.
MEMORY_PATH="./memory"

# --- SECURITY & SANDBOX ---
# ALLOW_UNSAFE_EVAL: Set to 'true' only if running in a strictly isolated container.
ALLOW_UNSAFE_EVAL="false"